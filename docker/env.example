# mnem0nic memory service: the environment file. Copy it to .env, fill it in, and keep it out of
# version control and readable by you only (chmod 600 .env).
# Compose expands "$" in values, so make the token hex: openssl rand -hex 32

# The door's bearer token. Required: with it empty the daemon refuses to start.
MNEM0NIC_HTTP_TOKEN=

# The provider that writes notes for saves with "mode": "extract" (any Anthropic-compatible
# /v1/messages endpoint). Leave both empty to store text as it is. The URL must be https.
MNEM0NIC_OBSERVER_API_KEY=
MNEM0NIC_OBSERVER_API_BASE_URL=
